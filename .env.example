# Docker Compose configuration. Copy to .env; never commit real credentials.
APP_PORT=8080
APP_URL=http://localhost:8080
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=
DB_PASSWORD=novacart
INVENTORY_DB_PASSWORD=inventory

# Generate these locally, for example with: openssl rand -hex 32
RABBITMQ_PASSWORD=
REVERB_APP_KEY=novacart-local
REVERB_APP_SECRET=
RABBITMQ_MANAGEMENT_PORT=15672
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1
REVERB_PUBLIC_HOST=localhost
REVERB_PUBLIC_SCHEME=http

# Shared project Gmail sender; use an app password supplied privately by its owner.
MAIL_SCHEME=smtps
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
# Comma-separated controlled customer addresses allowed to receive test mail.
MAIL_RECIPIENT_ALLOWLIST=
