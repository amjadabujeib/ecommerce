APP_NAME="NovaCart"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=internet_applications
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Default administrator (used by AdminUserSeeder)
# Leave ADMIN_PASSWORD empty to generate a strong random password while seeding.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=""

JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

CORS_ALLOWED_ORIGINS=*

# Inventory service (services/inventory), reached over gRPC.
# Locally: run the service on port 50051; in Docker this is inventory:50051.
INVENTORY_GRPC_ADDRESS=127.0.0.1:50051
INVENTORY_TIMEOUT_MS=2000

# Optional performance overlay; ordinary database reads can use PostgreSQL standby.
READ_REPLICA_ENABLED=false
CATALOG_CACHE_ENABLED=false
CATALOG_CACHE_STORE=catalog
CATALOG_CACHE_TTL=60
# Exclusive catalog database: invalidation physically clears every key here.
REDIS_CATALOG_DB=2
REDIS_CACHE_TIMEOUT=0.5
REDIS_CACHE_READ_WRITE_TIMEOUT=0.5

# Optional requirement 4 overlay. Generate secrets locally; never commit them.
MESSAGING_ENABLED=false
MESSAGING_PUBLISH_IMMEDIATELY=true
MESSAGING_RETRY_DELAYS=5,30,120
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_VHOST=novacart
RABBITMQ_USER=novacart
RABBITMQ_PASSWORD=
RABBITMQ_MANAGEMENT_PORT=15672
REVERB_APP_ID=novacart
REVERB_APP_KEY=novacart-local
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8081
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1
REVERB_PUBLIC_HOST=localhost
REVERB_PUBLIC_SCHEME=http
MAIL_TIMEOUT=15
# Real-send demos only target addresses you control.
MAIL_REQUIRE_ALLOWLIST=true
MAIL_RECIPIENT_ALLOWLIST=
